# --- La pagina 0 ACABA EN MITAD DE UNA RUTINA (2026-08-19, lo vio el agente
# anotador): 0x5FD7 (estado E250 = 3) llega a 0x5FFD `ld a,(E27E)` y el flujo
# sigue en 0x6000, que con 1/2/3 es ESTA pagina. Que en ese punto esta la
# pagina 1 en 0x6000 esta MEDIDO: los `call 0x626C` y `call 0x62AC` de p00
# 0x5FF2/0x5FF5, dos instrucciones antes, resolvieron en p01 (bancos.log), y
# entre medias no se toca el mapper.
0x6000   # cae desde p00:5FFD (fin de la pagina 0; la 1 medida en 0x5FF2/0x5FF5)

# --- Los seis "trucos" de la pantalla INPUT PASSWORD (2026-08-19, lo vio el
# agente anotador; comprobado sobre la ROM): 0x7474 compara el texto tecleado
# (EA52) con cada entrada de la tabla 0x7497 (MAXPOINT, " UJM3EDC",
# MITAIYOENDDEMO, HYPEROFF, ESCON, ESCOFF; acaban en 0xFF) y si casa hace
# `jp (hl)` (0x748F) al byte que sigue al 0xFF, con 0x7490 como retorno
# (push de,0x7490 en 0x748B). Las seis direcciones salen de la ROM.
0x7490   # retorno empujado por 0x748B (`xor a / ret`): Z = contrasena especial aceptada
0x74AC   # jp (hl) de 0x748F tras "MAXPOINT" (0x74A3, FF en 0x74AB)
0x74C4   # jp (hl) de 0x748F tras " UJM3EDC" (0x74BB, FF en 0x74C3)
0x74F1   # jp (hl) de 0x748F tras "MITAIYOENDDEMO" (0x74E2, FF en 0x74F0)
0x7504   # jp (hl) de 0x748F tras "HYPEROFF" (0x74FB, FF en 0x7503)
0x7510   # jp (hl) de 0x748F tras "ESCON" (0x750A, FF en 0x750F)
0x751D   # jp (hl) de 0x748F tras "ESCOFF" (0x7516, FF en 0x751C)

# --- Mas cosas que vio el agente anotador (2026-08-19), comprobadas en la ROM:
0x6057   # desde p00:5FE1 (`jr z,$+118` = 0x6057: un salto relativo que CRUZA de la pagina 0 a esta, con 1/2/3 como en 0x5FF2)
0x7C4F   # entrada 1 de la tabla de 3 palabras de 0x7C49 del `call 0x4ACB` de 0x7C46 (DESPACHA_AF: como 0x40DA pero con A' y exx)
0x7C56   # entradas 0 y 2 de la tabla de 0x7C49 (idem)

# --- CODIGO SIN LLAMADOR CONOCIDO (2026-08-19): igual que en la pagina 2, son
# huecos entre bloques trazados que se leen como codigo bien formado. Se
# siembran para verlos desensamblados en el listado.
0x67FC   # sin llamador: IX = E29C o E35C segun (E25F), como 0x67F0 con HL
0x70CC   # sin llamador: si (ix+31) ... and 0xFE -> (ix+31)
0x740C   # sin llamador: E1C4 = 0x3C y sigue en 0x73C9 (E252++)
0x7492   # sin llamador: cp (hl) / inc hl / ret nz / jr 0x7481 (cola de 0x748B)
0x7FE9   # sin llamador: C si (E208) es 0 o 4
0x6B3D   # sin llamador: E29D = E35D = 0 y estado 0x10 (jp 0x6049)
0x7BE9   # sin llamador: HL = A*256, por 0x4A6D, x5 (H:L*5) con tope 0xFF

# --- Codigo sin llamador, sembrado por lo que dicen los propios bytes.
# 2026-08-20.
0x6B6F   # sin llamador: `ld d,0BDh` y cae en COMPARA_PUNTOS_D (0x6B71); es la entrada gemela de PUNTOS_0xB4 (0x6B6B), que la salta con su `jr $+4`
