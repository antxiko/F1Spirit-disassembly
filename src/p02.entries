# --- Una instruccion que CRUZA la frontera de pagina (2026-08-19, lo vio el
# agente anotador): p01 0x7FFC (`ld a,(ix+4)`, medido desde p02:9E40) sigue
# con `sub nn` en 0x7FFF, y el operando nn es el byte 0x8000 de ESTA pagina
# (0xD4); la instruccion siguiente empieza en 0x8001.
0x8001   # continuacion de p01:7FFF (`sub 0xD4`, operando en 0x8000): ld a,0 / jp p / inc a / ld (E208),a / ret

# --- CODIGO SIN LLAMADOR CONOCIDO (2026-08-19). Ninguna instruccion de la ROM
# apunta a estas direcciones (lo vio el agente anotador leyendo la pagina y lo
# confirma que cada una de ellas es justo un hueco entre dos bloques ya
# trazados). Se siembran para poder LEERLAS en el listado: si de verdad son
# codigo, el trazado cubre el hueco entero y acaba donde empieza el bloque
# siguiente; si sobrara o faltara un byte, seria que no lo son.
0x86BC   # sin llamador: E217 = 0, E218 = 8, sonido 0x2B, ei, ret
0x87DD   # sin llamador: ld a,0x46 / jp 0x4174 (pide el sonido 0x46)
0x8846   # sin llamador: call 0x8852 / jp 0x4174 (igual que 0x884C)
0x885A   # sin llamador: compara E31D y E3DD con 3
0x8CD4   # sin llamador: HL = E380 o E2C0 segun (ix+9)
0x8D38   # sin llamador: ld hl,0 (0x8D27 salta a 0x8D4D y 0x8D36 a 0x8D3B)
0x8E27   # sin llamador: dos rutinas (terreno 11 y un contador que gira el coche)
0x8ED6   # sin llamador: casilla bajo el coche y tres tiles contra E26C/E272
0x90C1   # sin llamador: anillo de 30 velocidades en (IX & 0xFF00) + 0xC0
0x93EE   # sin llamador: por los bits 2/3 de E1C9 pone (ix+C) = 0, 6 o -6
0x9AEB   # sin llamador: (ix+3,4) += (ix+7,8)
0x9B47   # sin llamador: call 0x9B62 y cuatro add hl,hl
0x9DEB   # sin llamador: compara HL con 0x200/0x600 y 0xFF00/0xFC00
0x9F72   # sin llamador: un `jr $` (dos bytes)
0x86CB   # sin llamador: xor a / ld (E190),a / ret (la segunda rutina del hueco de 0x86BC)
0x8E3E   # sin llamador: la segunda rutina del hueco de 0x8E27 (contador que gira el coche)
0x80F4   # sin llamador EN LA PAGINA: entra p03 0xB983 con un `jp 0x80F4`; ld a,2 / ld (E208),a / ret
0x875F   # sin llamador: xor a y salta a 0x8763 (cola de otra rutina)
0x8C64   # sin llamador: (ix+13) = 0, (ix+12) = 0xE0 y call 0x8CC1
0x9CC5   # sin llamador: (ix+12) = 0 / ret
